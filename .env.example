# ========================================
# JWT 密钥（生产环境必须配置强随机密钥）
# 生成方式: openssl rand -base64 32
# ========================================
JWT_SECRET=your-secret-key-change-in-production

# ========================================
# 数据库配置（必须配置）
# 从 Supabase 项目设置 > API 中获取
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 以下为服务端专用（可选，优先级高于 NEXT_PUBLIC_ 前缀）
DATABASE_URL=https://your-project.supabase.co
DATABASE_KEY=your-anon-key

# ========================================
# DeepSeek API 配置（AI生成功能）
# 从 https://platform.deepseek.com 获取
# ========================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ========================================
# 邮箱服务配置（登录验证码）
# ========================================
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@163.com
EMAIL_PASS=your_email_authorization_code
EMAIL_FROM=your-email@163.com

# ========================================
# 管理员配置
# ========================================
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_SUPER_ADMIN_USERNAME=admin

# ========================================
# 其他配置
# ========================================
NODE_ENV=development
